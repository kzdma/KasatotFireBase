<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="KasatotFireBase.Resources.Styles.MyStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="FormBorder" TargetType="Border">
        <Setter Property="Margin" Value="30,0,30,10" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Stroke" Value="Gray" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="FormEntry" TargetType="Entry">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="Gray" />
        <Setter Property="Placeholder" Value="Enter text here" />
    </Style>

</ResourceDictionary>